 const current=labels.map(d=>Math.round(indicators.filter(x=>x[0]===d).reduce((s,x)=>s+x[2],0)/(indicators.filter(x=>x[0]===d).length||1)));
 const target=labels.map(d=>Math.round(indicators.filter(x=>x[0]===d).reduce((s,x)=>s+x[3],0)/(indicators.filter(x=>x[0]===d).length||1)));
 charts.scores=new Chart(document.getElementById("scores"),{type:"bar",data:{labels,datasets:[{label:"الحالية",data:current},{label:"المستهدفة",data:target}]},options:base});
 charts.levels=new Chart(document.getElementById("levels"),{type:"bar",data:{labels,datasets:[{label:"المستوى الحالي",data:current.map(v=>Math.round(v/20))},{label:"المستوى المستهدف",data:target.map(v=>Math.round(v/20))}]},options:{...base,scales:{...base.scales,y:{beginAtZero:true,max:5}}}});
 const achieved=indicators.filter(x=>x[2]>=x[3]).length;
 charts.donutIndicators=new Chart(document.getElementById("donutIndicators"),{type:"doughnut",data:{labels:["متحقق","يحتاج تحسين"],datasets:[{data:[achieved,indicators.length-achieved]}]},options:{plugins:{legend:{position:"bottom"}}}});
 const domainProgress=labels.map(d=>programs.filter(p=>p.domain===d).length?Math.round(programs.filter(p=>p.domain===d).reduce((s,p)=>s+p.progress,0)/programs.filter(p=>p.domain===d).length):0);
 charts.domains=new Chart(document.getElementById("domains"),{type:"bar",data:{labels,datasets:[{label:"نسبة الإنجاز",data:domainProgress}]},options:base});
 charts.timeline=new Chart(document.getElementById("timeline"),{type:"line",data:{labels:["محرم","صفر","ربيع الأول","ربيع الآخر","جمادى الأولى","جمادى الآخرة"],datasets:[{label:"نسبة التنفيذ",data:[15,28,42,55,68,78],tension:.35,fill:false}]},options:base});
 charts.vision=new Chart(document.getElementById("visionChart"),{type:"bar",data:{labels:["مجتمع حيوي","اقتصاد مزدهر","وطن طموح","تحول رقمي"],datasets:[{label:"نسبة المواءمة",data:[88,76,91,84]}]},options:{...base,indexAxis:"y",scales:{x:{beginAtZero:true,max:100}}}});
 const impacts=programs.map(p=>({name:p.name,before:p.previous||60,after:p.value||p.progress,target:p.valueTarget||90})).slice(0,6);
 charts.impact=new Chart(document.getElementById("impactChart"),{type:"bar",data:{labels:impacts.map(x=>x.name),datasets:[{label:"قبل التنفيذ",data:impacts.map(x=>x.before)},{label:"بعد التنفيذ",data:impacts.map(x=>x.after)},{label:"المستهدف",data:impacts.map(x=>x.target)}]},options:base});
 const hi=programs.filter(p=>(p.value||0)>=((p.valueTarget||90)*.9)).length,mid=programs.filter(p=>(p.value||0)>=((p.valueTarget||90)*.7)&&(p.value||0)<((p.valueTarget||90)*.9)).length,low=programs.length-hi-mid;
 document.getElementById("impactCards").innerHTML=[["أثر مرتفع",hi],["أثر متوسط",mid],["تحتاج تطويرًا",low],["متوسط التحسن",Math.round(programs.reduce((s,p)=>s+Math.max(0,(p.value||0)-(p.previous||0)),0)/(programs.length||1))+"%"],["متوسط تحقق الأهداف",Math.round(programs.reduce((s,p)=>s+p.progress,0)/(programs.length||1))+"%"],["إجمالي المستفيدين",programs.length*35]].map(x=>`<div class="kpi" style="min-height:92px"><div class="kpiTop">${x[0]}</div><div class="kpiValue" style="font-size:20px">${x[1]}</div></div>`).join("");
}
