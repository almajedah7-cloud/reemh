function makeCharts(){
 destroyCharts();const labels=domains;
 const base={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{font:{family:"Tahoma"}}}},scales:{x:{ticks:{font:{family:"Tahoma"}}},y:{beginAtZero:true,max:100,ticks:{font:{family:"Tahoma"}}}}};
