function renderKpis(){
 const completed=programs.filter(p=>p.status==="مكتمل").length, running=programs.filter(p=>p.status==="جاري التنفيذ").length, notStarted=programs.filter(p=>p.status==="لم يبدأ").length;
 const late=programs.filter(p=>p.end && new Date(p.end)<new Date() && p.status!=="مكتمل").length;
 const avg=programs.length?Math.round(programs.reduce((s,p)=>s+Number(p.progress||0),0)/programs.length):0;
 const indAvg=Math.round(indicators.reduce((s,x)=>s+x[2],0)/indicators.length);
 const targetAvg=Math.round(indicators.reduce((s,x)=>s+x[3],0)/indicators.length);
 const items=[
 ["الدرجة الحالية",indAvg,"◉","↑ تحسن","good"],["المستوى الحالي",level(indAvg),"◆","مستوى الأداء","good"],["المستوى المستهدف","ممتاز","◎","الهدف الوطني","good"],["الدرجة المستهدفة",targetAvg,"◎","الهدف","good"],
 ["نسبة تحقق خطة التحسين",avg+"%","◔","محسوبة تلقائيًا","good"],["نسبة التحسن",Math.max(0,Math.round(indAvg-65))+"%","↗","مقارنة بالخط الأساس","good"],["إجمالي المؤشرات",indicators.length,"☷","جميع المجالات","good"],["إجمالي البرامج والمبادرات",programs.length,"▣","مبادرات مسجلة","good"],
 ["البرامج المنفذة",completed,"✓","مكتمل","good"],["البرامج قيد التنفيذ",running,"◷","متابعة","warn"],["البرامج غير المنفذة",notStarted,"×","لم يبدأ","bad"],["نسبة التنفيذ",programs.length?Math.round(completed/programs.length*100):0+"%","◔","مكتمل من الإجمالي","good"],
 ["عدد المتابعات",programs.length*2,"□","سجلات متابعة","good"],["عدد شواهد التحقق",programs.filter(p=>p.link).length,"◇","روابط شواهد","good"],["المؤشرات التي تحتاج تحسين",indicators.filter(x=>x[2]<75).length,"!","تحتاج متابعة","warn"],["البرامج المتأخرة",late,"⚠","تحتاج تدخل","bad"]
 ];
 document.getElementById("kpis").innerHTML=items.map(a=>`<div class="kpi"><div class="kpiTop"><span>${a[0]}</span><span class="kpiIcon">${a[2]}</span></div><div class="kpiValue">${typeof a[1]==="number"&&a[0].includes("نسبة")?a[1]+"%":a[1]}</div><div class="trend ${a[4]}">${a[3]}</div></div>`).join("");
 document.getElementById("alertCount").textContent=late+notStarted;
}
function renderIndicators(){
 const q=(document.getElementById("searchIndicator").value||"").toLowerCase(), fd=document.getElementById("filterDomain").value, fs=document.getElementById("filterStatus").value;
 const rows=indicators.map((x,i)=>{let s=x[2]>=x[3]?"مكتمل":x[2]>=75?"قيد التحسين":"يحتاج تدخل";return {x,i,s}}).filter(o=>(!q||o.x.join(" ").toLowerCase().includes(q))&&(!fd||o.x[0]===fd)&&(!fs||o.s===fs));
 document.getElementById("indicatorBody").innerHTML=rows.map((o,k)=>{let x=o.x,improve=Math.max(0,Math.round((x[2]-60)/60*100)),done=pct(x[2],x[3]);return `<tr><td>${o.i+1}</td><td>${x[0]}</td><td style="max-width:310px">${x[1]}</td><td>${x[2]}</td><td>${level(x[2])}</td><td>${x[3]}</td><td>${level(x[3])}</td><td>${improve}%</td><td>${done}%<div class="progress"><span style="width:${done}%"></span></div></td><td>${o.s==="مكتمل"?'<span class="badge bgreen">مكتمل</span>':o.s==="قيد التحسين"?'<span class="badge byellow">قيد التحسين</span>':'<span class="badge bred">يحتاج تدخل</span>'}</td><td><div class="actions"><button class="mini" onclick="viewIndicator(${o.i})">عرض</button><button class="mini" onclick="editIndicator(${o.i})">تعديل</button><button class="mini" onclick="deleteIndicator(${o.i})">حذف</button></div></td></tr>`}).join("");
}
